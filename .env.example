# Copy to `.env` and fill in before building.

# Your site's name. Used as the <title> on the home page and as og:site_name.
SITE_NAME=

# The public origin the site will be served from, no trailing slash.
#
# Absolute URLs are baked in at BUILD time — canonical, og:url, sitemap.xml and
# llms.txt all need them, and llms.txt in particular is fetched and handed to a
# model detached from its origin, where a relative path resolves to nothing.
#
# Leave it empty and the build still succeeds: it writes robots.txt and skips
# the sitemap and llms.txt rather than emitting links to a guessed host.
SITE_URL=
